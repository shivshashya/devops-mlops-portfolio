---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { projects } from '../../data/site';

const project = projects.find((item) => item.slug === Astro.params.slug);
if (!project) return Astro.redirect('/work');
---

<BaseLayout title={`${project.title} — Case Study`} description={project.description}>
	<SiteHeader active="work" />
	<main id="main-content" class="site-shell page-main case-study">
		<a class="back-link" href="/work">← All work</a>
		<section class={`case-hero accent-${project.accent}`}><p class="section-number">{project.label}</p><h1>{project.title}</h1><p>{project.description}</p><ul>{project.stack.map((item) => <li>{item}</li>)}</ul></section>
		<section class="case-architecture" aria-labelledby="architecture-title"><div><p class="section-number">System path</p><h2 id="architecture-title">From input to <em>evidence.</em></h2></div><ol>{project.steps.map((step, index) => <li><span>0{index + 1}</span><strong>{step}</strong></li>)}</ol></section>
		<section class="case-notes" aria-label="Project notes"><article><p class="section-number">Challenge</p><p>{project.challenge}</p></article><article><p class="section-number">Approach</p><p>{project.approach}</p></article><article><p class="section-number">What it reinforced</p><p>{project.learned}</p></article></section>
		<a class="button button-coral" href="/contact">Discuss this kind of work <span aria-hidden="true">↗</span></a>
	</main>
</BaseLayout>
