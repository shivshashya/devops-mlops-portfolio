---
import BaseLayout from '../layouts/BaseLayout.astro';
import { capabilities, profile, projects } from '../data/site';

const title = `${profile.name} — ${profile.role}`;
const description = 'A DevOps-first portfolio of delivery systems, Kubernetes operations, and evidence-based MLOps projects.';
---

<BaseLayout {title} {description}>
	<header class="site-header site-shell">
		<a class="wordmark" href="/" aria-label="Portfolio home"><span aria-hidden="true">◒</span> {profile.name}</a>
		<nav aria-label="Primary navigation"><a href="/work">Work</a><a href="/about">About</a><a href="/contact">Contact</a></nav>
		<a class="header-cta" href="/contact">Let’s talk <span aria-hidden="true">↗</span></a>
	</header>

	<main id="main-content">
		<section class="hero site-shell" aria-labelledby="hero-title">
			<div class="hero-copy">
				<p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>{profile.availability}</p>
				<h1 id="hero-title">Build it.<br /><span>Ship it.</span><br />Observe it.</h1>
				<p class="hero-lead">{profile.intro}</p>
				<div class="hero-actions"><a class="button button-coral" href="/work">Explore the work <span aria-hidden="true">↓</span></a><a class="text-link" href="/about">About the practice <span aria-hidden="true">↗</span></a></div>
			</div>

			<div class="signal-stage" aria-label="A deployment path from source change to production signal">
				<div class="stage-label"><span>Live system map</span><span>01 / 03</span></div>
				<div class="signal-pillar"><span class="pillar-kicker">DevOps<br />system<br />design</span><svg viewBox="0 0 260 420" aria-hidden="true"><path d="M130 30v84M130 178v68M130 310v80" /><circle cx="130" cy="132" r="18" /><circle cx="130" cy="278" r="18" /><path d="M130 114 70 154M130 114l60 40M130 296 70 336M130 296l60 40" /><circle cx="60" cy="162" r="8" /><circle cx="200" cy="162" r="8" /><circle cx="60" cy="344" r="8" /><circle cx="200" cy="344" r="8" /></svg><span class="pillar-footer">Source → Signal</span></div>
				<div class="stage-card"><p class="eyebrow">Current focus</p><strong>Reliable paths<br />for real software.</strong><p>Delivery systems, cloud-native operations, and reviewable AI workflows.</p></div>
			</div>

			<aside class="hero-aside" aria-label="Portfolio summary">
				<div class="aside-block"><p class="eyebrow">Based in</p><p>{profile.location}</p></div>
				<div class="aside-block"><p class="eyebrow">Primary craft</p><p>DevOps & platform engineering</p></div>
				<div class="aside-block aside-focus"><p class="eyebrow">Selected project</p><a href={`/work/${projects[0].slug}`}><span>01</span>{projects[0].title}<b aria-hidden="true">↗</b></a></div>
				<div class="aside-controls" aria-hidden="true"><span>01</span><i></i><span>03</span></div>
			</aside>
		</section>

		<section class="statement-wrap" aria-labelledby="statement-title">
			<div class="site-shell statement-grid"><p class="section-number">01 / Perspective</p><div><h2 id="statement-title">Good infrastructure gives teams <em>room to think.</em></h2><p>I focus on the practical details that make a system dependable: repeatable releases, useful health signals, clear recovery paths, and automation people can inspect.</p></div><a class="round-link" href="/about" aria-label="Read more about this approach">↘</a></div>
		</section>

		<section class="work-section site-shell" aria-labelledby="work-title">
			<div class="section-heading"><div><p class="section-number">02 / Selected work</p><h2 id="work-title">Evidence over<br /><em>empty claims.</em></h2></div><p>Three hands-on projects exploring the systems behind dependable delivery and responsible automation.</p></div>
			<div class="work-grid">
				{projects.map((project, index) => (
					<article class={`work-card work-card-${project.accent}`}>
						<div class="card-meta"><span>0{index + 1}</span><span>{project.label.split(' / ')[1]}</span></div>
						<div class="card-visual" aria-hidden="true"><span></span><i></i><b></b><em></em></div>
						<div class="card-copy"><h3>{project.title}</h3><p>{project.description}</p></div>
						<a class="card-link" href={`/work/${project.slug}`} aria-label={`Read ${project.title} case study`}><span>View case study</span><b aria-hidden="true">↗</b></a>
					</article>
				))}
			</div>
		</section>

		<section class="capabilities-section" aria-labelledby="capabilities-title">
			<div class="site-shell"><div class="capabilities-heading"><p class="section-number">03 / The practice</p><h2 id="capabilities-title">The work behind the <em>release.</em></h2></div><div class="capability-grid">{capabilities.map((capability) => <article><span>{capability.number}</span><h3>{capability.title}</h3><p>{capability.description}</p></article>)}</div></div>
		</section>

		<section class="contact-banner site-shell" aria-labelledby="contact-title"><p class="section-number">04 / Contact</p><div><h2 id="contact-title">Looking for a thoughtful DevOps partner?</h2><a class="button button-light" href="/contact">Start a conversation <span aria-hidden="true">↗</span></a></div></section>
	</main>

	<footer class="site-footer site-shell"><p>© 2026 {profile.name}</p><div><a href={profile.github} target="_blank" rel="noreferrer">GitHub ↗</a><a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a></div></footer>
</BaseLayout>
