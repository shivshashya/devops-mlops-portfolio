---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { projects } from '../../data/site';
---

<BaseLayout title="Selected Work — DevOps & MLOps" description="Case studies in continuous delivery, Kubernetes troubleshooting, and reviewable local AI workflows.">
	<SiteHeader active="work" />
	<main id="main-content" class="site-shell page-main">
		<section class="page-intro"><p class="section-number">Selected work / 03 projects</p><h1>Systems you can <span>inspect.</span></h1><p>Practical projects that make delivery, operations, and human review easier to understand.</p></section>
		<section class="case-list" aria-label="Case studies">{projects.map((project, index) => <article class={`case-row accent-${project.accent}`}><div class="case-number">0{index + 1}</div><div><p class="eyebrow">{project.label}</p><h2>{project.title}</h2><p>{project.description}</p><ul>{project.stack.map((item) => <li>{item}</li>)}</ul></div><a href={`/work/${project.slug}`} aria-label={`Open ${project.title} case study`}>↗</a></article>)}</section>
	</main>
</BaseLayout>
